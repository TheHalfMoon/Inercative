{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ineractive.dev/schemas/provenance/import-record.schema.json",
  "title": "Ineractive Donor Provenance Import Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "destination",
    "useMode",
    "authority",
    "licensing",
    "dependencyClosure",
    "modificationSummary",
    "securityImpact",
    "verificationEvidence",
    "reviewEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "paths"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "useMode": {
      "enum": ["COPY", "ADAPT", "DEPEND"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": ["FOUNDER_PERMISSION", "LICENSE", "CONTRACT", "OTHER"]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["licenseExpression", "noticeRequired", "noticeReference"],
      "properties": {
        "licenseExpression": {
          "type": "string",
          "minLength": 1
        },
        "noticeRequired": {
          "type": "boolean"
        },
        "noticeReference": {
          "type": ["string", "null"]
        }
      }
    },
    "dependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references"],
      "properties": {
        "status": {
          "enum": ["COMPLETE", "PARTIAL", "UNRESOLVED"]
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modificationSummary": {
      "type": "string",
      "minLength": 1
    },
    "securityImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "summary"],
      "properties": {
        "level": {
          "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
