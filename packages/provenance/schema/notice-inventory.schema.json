{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ineractive.dev/schemas/notice-inventory.v1.json",
  "title": "Ineractive Third-Party Notice Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRecordCount", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRepository",
          "sourceRevision",
          "sourcePaths",
          "destinationPaths",
          "useMode",
          "authorityKind",
          "authorityReference",
          "licenseExpression",
          "noticeRequired",
          "noticeReference"
        ],
        "properties": {
          "sourceRepository": { "type": "string", "minLength": 1 },
          "sourceRevision": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
          },
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "destinationPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "useMode": { "enum": ["COPY", "ADAPT", "DEPEND"] },
          "authorityKind": {
            "enum": ["FOUNDER_PERMISSION", "LICENSE", "CONTRACT", "OTHER"]
          },
          "authorityReference": { "type": "string", "minLength": 1 },
          "licenseExpression": { "type": "string", "minLength": 1 },
          "noticeRequired": { "type": "boolean" },
          "noticeReference": {
            "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          }
        }
      }
    }
  }
}
