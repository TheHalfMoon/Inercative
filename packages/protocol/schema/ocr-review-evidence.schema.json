{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ineractive.dev/schemas/ocr-review-evidence.v1.json",
  "title": "Ineractive Alibaba OCR Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "tool",
    "fileAccounting",
    "ruleResolution",
    "semanticReview",
    "reconciliation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "mergeBase"],
      "properties": {
        "base": { "$ref": "#/$defs/gitSha" },
        "head": { "$ref": "#/$defs/gitSha" },
        "mergeBase": { "$ref": "#/$defs/gitSha" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "release", "binarySha256", "configIdentity"],
      "properties": {
        "name": { "const": "alibaba/open-code-review" },
        "release": { "type": "string", "minLength": 1 },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "configIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "fileAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedFiles", "reviewableFiles", "excludedFiles", "separateReviews"],
      "properties": {
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "changeType"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "changeType": { "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED", "COPIED"] }
            }
          }
        },
        "reviewableFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "excludeReason", "material"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "excludeReason": { "type": "string", "minLength": 1 },
              "material": { "type": "boolean" }
            }
          }
        },
        "separateReviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "method", "evidenceReference"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "method": { "type": "string", "minLength": 1 },
              "evidenceReference": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "ruleResolution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ruleSetIdentity", "evidenceReference"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "ruleSetIdentity": { "type": "string", "minLength": 1 },
          "evidenceReference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticReview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blocker", "output", "findings"],
          "properties": {
            "state": { "const": "RUN" },
            "blocker": { "type": "null" },
            "output": { "$ref": "#/$defs/semanticOutput" },
            "findings": {
              "type": "array",
              "items": { "$ref": "#/$defs/finding" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blocker", "output", "findings"],
          "properties": {
            "state": { "enum": ["BLOCKED", "NOT_RUN"] },
            "blocker": { "$ref": "#/$defs/blocker" },
            "output": { "type": "null" },
            "findings": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "reconciliation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromHead", "toHead", "diffUnchanged", "evidenceReference"],
          "properties": {
            "fromHead": { "$ref": "#/$defs/gitSha" },
            "toHead": { "$ref": "#/$defs/gitSha" },
            "diffUnchanged": { "const": true },
            "evidenceReference": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "semanticOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "reference", "sha256"],
      "properties": {
        "format": { "enum": ["JSON", "SARIF"] },
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "evidenceReference"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceReference": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "path",
        "material",
        "disposition",
        "rationale",
        "evidenceReference"
      ],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "disposition": {
          "enum": ["FIXED", "ACCEPTED_RISK", "FALSE_POSITIVE", "DEFERRED_BLOCKING", "UNRESOLVED"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceReference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
