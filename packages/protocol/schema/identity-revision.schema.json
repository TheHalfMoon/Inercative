{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ineractive.dev/schemas/identity-revision.v1.json",
  "title": "Ineractive Identity Revision Reference",
  "$ref": "#/$defs/identityRevisionRef",
  "$defs": {
    "protocolId": {
      "type": "string",
      "pattern": "^ineractive:(?:project|workspace|work|run|event|artifact|evidence|finding|resource):[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revisionRef": {
      "type": "string",
      "pattern": "^(?:git:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
    },
    "identityRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/protocolId"
        },
        "revision": {
          "$ref": "#/$defs/revisionRef"
        }
      }
    }
  }
}
