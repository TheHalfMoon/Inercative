{
  "name": "ineractive",
  "version": "0.0.0",
  "private": true,
  "description": "Ineractive — AI Product Compiler. P00 repository and delivery foundation.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.4.2 <13"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/**\" run typecheck",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
